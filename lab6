class Product:
    """Represents an individual product with its own attributes and state management."""
    def __init__(self, product_id: str, name: str, price: float, stock: int):
        self._product_id = product_id  # Encapsulated (private convention)[cite: 3]
        self._name = name
        self._price = price
        self._stock = stock

    @property
    def product_id(self) -> str:
        return self._product_id

    @property
    def name(self) -> str:
        return self._name

    @property
    def price(self) -> float:
        return self._price

    @property
    def stock(self) -> int:
        return self._stock

    def update_stock(self, quantity: int) -> None:
        """Encapsulates stock modification to prevent invalid states."""
        new_stock = self._stock + quantity
        if new_stock < 0:
            print("Error: Stock cannot be negative!")
        else:
            self._stock = new_stock
            print(f"Stock updated successfully for {self._name}. Current stock: {self._stock}")

    def display_information(self) -> None:
        """Displays individual product details."""
        print(f"ID: {self._product_id} | Name: {self._name} | Price: ${self._price:.2f} | Stock: {self._stock}")

    def to_dict(self) -> dict:
        """Helper to convert the object back to a dictionary for JSON serialization."""
        return {
            "product_id": self._product_id,
            "name": self._name,
            "price": self._price,
            "stock": self._stock
        }

class Inventory:
    """Manages a collection of Product objects following the Single Responsibility Principle[cite: 4, 5]."""
    def __init__(self):
        # Using a dictionary mapping product_id to Product object for fast lookups
        self._products = {}

    def add_product(self, product: Product) -> bool:
        """Adds a product to the inventory collection[cite: 4]."""
        if product.product_id in self._products:
            print(f"Error: Product ID {product.product_id} already exists.")
            return False
        self._products[product.product_id] = product
        print(f"Product '{product.name}' added successfully.")
        return True

    def search_product(self, product_id: str) -> Product:
        """Searches for and returns a Product object by ID[cite: 4]."""
        return self._products.get(product_id)

    def display_all(self) -> None:
        """Displays all products in the inventory[cite: 4]."""
        if not self._products:
            print("\nInventory is currently empty.")
            return
        
        print("\n--- Current Inventory ---")
        for product in self._products.values():
            product.display_information()
        print("-------------------------")
        
def main():
    inventory = Inventory()
    inventory.load_from_file("inventory.json")

    while True:
        print("\n=== Inventory Management System ===")
        print("1. Display all products")
        print("2. Add a product")
        print("3. Update stock")
        print("4. Search for a product")
        print("5. Save inventory")
        print("6. Exit")
        
        choice = input("Enter your choice (1-6): ").strip()
        
        if choice == '1':
            inventory.display_all()
            
        elif choice == '2':
            pid = input("Enter Product ID: ").strip()
            name = input("Enter Product Name: ").strip()
            try:
                price = float(input("Enter Price ($): "))
                stock = int(input("Enter Initial Stock Quantity: "))
                new_product = Product(pid, name, price, stock)
                inventory.add_product(new_product)
            except ValueError:
                print("Invalid input! Price must be a number and stock must be an integer.")
                
        elif choice == '3':
            pid = input("Enter Product ID to update stock: ").strip()
            product = inventory.search_product(pid)
            if product:
                try:
                    qty = int(input("Enter stock change amount (use negative number to reduce stock): "))
                    product.update_stock(qty)
                except ValueError:
                    print("Invalid input! Quantity must be an integer.")
            else:
                print(f"Product with ID '{pid}' not found.")
                
        elif choice == '4':
            pid = input("Enter Product ID to search: ").strip()
            product = inventory.search_product(pid)
            if product:
                print("\nProduct Found:")
                product.display_information()
            else:
                print(f"Product with ID '{pid}' not found.")
                
        elif choice == '5':
            inventory.save_to_file("inventory.json")
            
        elif choice == '6':
            inventory.save_to_file("inventory.json")
            print("Exiting program. Goodbye!")
            break
        else:
            print("Invalid choice. Please enter a number between 1 and 6.")


if __name__ == "__main__":
    import json
    import os
    main()