class Product:
    """Represents an individual product with its own attributes and state management."""
    def __init__(self, product_id: str, name: str, price: float, stock: int):
        self._product_id = product_id  # Encapsulated (private convention)[cite: 3]
        self._name = name
        self._price = price
        self._stock = stock

    @property
    def product_id(self) -> str:
        return self._product_id

    @property
    def name(self) -> str:
        return self._name

    @property
    def price(self) -> float:
        return self._price

    @property
    def stock(self) -> int:
        return self._stock

    def update_stock(self, quantity: int) -> None:
        """Encapsulates stock modification to prevent invalid states."""
        new_stock = self._stock + quantity
        if new_stock < 0:
            print("Error: Stock cannot be negative!")
        else:
            self._stock = new_stock
            print(f"Stock updated successfully for {self._name}. Current stock: {self._stock}")

    def display_information(self) -> None:
        """Displays individual product details."""
        print(f"ID: {self._product_id} | Name: {self._name} | Price: ${self._price:.2f} | Stock: {self._stock}")

    def to_dict(self) -> dict:
        """Helper to convert the object back to a dictionary for JSON serialization."""
        return {
            "product_id": self._product_id,
            "name": self._name,
            "price": self._price,
            "stock": self._stock
        }